; Engine configuration file.
config_version=5

[application]

config/name="Ball Breaker"
config/version="dev"
config/name_localized={
"en": "Ball Breaker",
"ru": "Шароломка"
}
run/main_scene="res://scenes/main_menu.tscn"
config/features=PackedStringArray("4.3", "GL Compatibility")
config/icon="res://icon.svg"
config/quit_on_go_back=false
run/max_fps=60

[autoload]

GameData="*res://scripts/game_data.gd"
Sfx="*res://scripts/audio.gd"

[debug]

gdscript/warnings/integer_division=0

[display]

window/size/viewport_width=720
window/size/viewport_height=1280
window/size/window_width_override=405
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1
window/energy_saving/keep_screen_on=false
window/vsync/vsync_mode=1

[input_devices]

pointing/emulate_mouse_from_touch=true

[internationalization]

locale/fallback="ru"

[physics]

common/physics_ticks_per_second=10
2d/default_gravity=0.0

[audio]

driver/enable_input=false

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.07, 0.08, 0.11, 1)
